{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Copy Creator",
  "version": "0.3.9",
  "identifier": "com.copycreator.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Copy Creator",
        "width": 560,
        "height": 640,
        "minWidth": 480,
        "minHeight": 460,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": false,
        "visible": false,
        "center": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:*; media-src 'self' data: blob: http://127.0.0.1:*; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:5173",
      "assetProtocol": {
      "enable": false,
      "scope": {
        "requireLiteralLeadingDot": false,
        "allow": ["**/*"]
      }
    }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "msi"],
    "resources": {
      "../scripts/copy-creator-ctl": "copy-creator-ctl"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "gstreamer1.0-libav"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "clipboard-manager": null,
    "global-shortcut": null,
    "autostart": null,
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyQjhEQkQyQzBCODM2RjgKUldUNE5yakEwdHU0TXB0bUtzOGY5Y3BaejF1bTEraFZJd1pVYmVpTnNDT3VKSWdPS2EwM01oMlYK",
      "endpoints": [
        "https://github.com/sheengoa/copy-creator/releases/latest/download/latest.json"
      ]
    }
  }
}
